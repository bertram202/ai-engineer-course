# Секреты — никогда не коммитить
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.ipynb_checkpoints/

# Данные и артефакты
data/
*.gguf
*.safetensors
mlruns/
catboost_info/

# Quarto (сайт и PDF собираются в _site/, _freeze/ коммитится)
/_site/
/.quarto/
**/*.quarto_ipynb
**/theory/*.pdf
**/theory/*.tex
**/theory/*.log
**/theory/*_files/

# ОС и редакторы
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
