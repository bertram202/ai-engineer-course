# Настройки моделей курса. Скопируйте в .env (make setup сделает это сам) и при желании поправьте.
# .env не коммитится — в нём могут быть ключи.

# Основная модель (роль main): любой OpenAI-совместимый endpoint.
# По умолчанию — та же локальная Ollama. Для своего сервера или облачного провайдера
# укажите его адрес, ключ и имя модели.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:8b

# Локальная модель (роль local) и модель эмбеддингов (роль embed) — в Ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_LOCAL_MODEL=qwen3:8b
EMBED_MODEL=bge-m3

# Кэш ответов LLM: on | off | record | refresh | replay (см. M00, раздел «Кассеты»)
LLM_CACHE=on
